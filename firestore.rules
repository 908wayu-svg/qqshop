rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    // อีเมลเจ้าของร้าน — เป็นแอดมินเสมอ (เพิ่มคนได้โดยใส่อีเมลในลิสต์นี้)
    // *** ถ้าแก้ตรงนี้ ต้องแก้ ADMIN_EMAILS ในไฟล์ auth.js ให้ตรงกันด้วย ***
    function ownerEmails() { return ['908wayu@gmail.com']; }

    function isAdmin() {
      return isSignedIn()
        && (request.auth.token.email in ownerEmails()
            || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
                && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }

    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // เช็คว่าฟิลด์เหล่านี้ไม่ถูกแก้
    function unchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ===== สมาชิก =====
    match /users/{uid} {
      allow read: if isAdmin() || isOwner(uid);

      // สมัครใหม่: ต้องเป็น uid ตัวเอง, role = member, เครดิตเริ่มต้น 0
      allow create: if isOwner(uid)
                    && request.resource.data.role == 'member'
                    && request.resource.data.credit == 0;

      // แก้โปรไฟล์ตัวเองได้ แต่ห้ามแตะ role และ credit เด็ดขาด
      allow update: if isAdmin()
                    || (isOwner(uid) && unchanged(['role', 'credit']));

      allow delete: if isAdmin();
    }

    // ===== สินค้า =====
    match /products/{id} {
      allow read: if true;                 // ลูกค้าดูได้ทุกคน
      allow write: if isAdmin();           // แก้ไขได้เฉพาะแอดมิน

      // คลังของสินค้าดิจิทัล — เก็บไอดี/รหัสผ่านรายชิ้น
      // ห้ามลูกค้าอ่านเด็ดขาด (ต่อให้เป็นชิ้นที่ตัวเองซื้อ)
      // ลูกค้าเห็นรหัสจากในออเดอร์ของตัวเองที่คัดลอกไปตอนแอดมินอนุมัติแทน
      match /stockItems/{itemId} {
        allow read, write: if isAdmin();
      }
    }

    // ===== ตั้งค่าร้าน (เช่น จุดเริ่มนับยอดขาย) =====
    match /settings/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ===== ออเดอร์ =====
    match /orders/{id} {
      // เบราว์เซอร์สร้างออเดอร์เองไม่ได้เลย ต้องผ่านเซิร์ฟเวอร์ (Cloudflare Worker)
      // ที่คิดราคาจากฐานข้อมูลเอง ลูกค้าจึงแก้ราคา/จำนวนก่อนส่งไม่ได้
      // (เซิร์ฟเวอร์ใช้ service account ซึ่งไม่ถูกกฎนี้บังคับ)
      allow create: if false;

      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);

      // อนุมัติ/ไม่อนุมัติ ทำได้เฉพาะแอดมิน
      allow update, delete: if isAdmin();
    }

    // ===== คำขอเติมเงิน =====
    match /topups/{id} {
      // สลิปต้องเป็นรูปภาพแบบ data: จริงๆ ไม่ใช่สตริงอะไรก็ได้
      // (กันลูกค้ายัดสคริปต์เข้าหน้าแอดมิน)
      function slipOk() {
        return !('slip' in request.resource.data.keys())
               || (request.resource.data.slip is string
                   && request.resource.data.slip.matches('^data:image/(png|jpeg|jpg|gif|webp);base64,[A-Za-z0-9+/=]+$')
                   && request.resource.data.slip.size() < 1000000);
      }
      // ลิงก์ซองต้องเป็นลิงก์ทรูมันนี่เท่านั้น
      function angpaoOk() {
        return !('angpaoLink' in request.resource.data.keys())
               || (request.resource.data.angpaoLink is string
                   && request.resource.data.angpaoLink.matches('^https://[a-z0-9.-]*truemoney[.]com/.*')
                   && request.resource.data.angpaoLink.size() < 500);
      }

      // แอดมินสร้างรายการให้ใครก็ได้ (ใช้ตอนเพิ่มเครดิตให้สมาชิก)
      // ลูกค้าสร้างได้เฉพาะของตัวเอง และต้องเริ่มที่สถานะ pending เสมอ
      allow create: if isAdmin()
                    || (isSignedIn()
                        && request.resource.data.uid == request.auth.uid
                        && request.resource.data.status == 'pending'
                        && request.resource.data.amount is number
                        && request.resource.data.amount > 0
                        && slipOk() && angpaoOk());

      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}

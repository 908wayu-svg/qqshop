rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    // อีเมลเจ้าของร้าน — เป็นแอดมินเสมอ (เพิ่มคนได้โดยใส่อีเมลในลิสต์นี้)
    // *** ถ้าแก้ตรงนี้ ต้องแก้ ADMIN_EMAILS ในไฟล์ auth.js ให้ตรงกันด้วย ***
    function ownerEmails() { return ['908wayu@gmail.com']; }

    function isAdmin() {
      return isSignedIn()
        && (request.auth.token.email in ownerEmails()
            || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
                && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }

    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // เช็คว่าฟิลด์เหล่านี้ไม่ถูกแก้
    function unchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ===== สมาชิก =====
    match /users/{uid} {
      allow read: if isAdmin() || isOwner(uid);

      // สมัครใหม่: ต้องเป็น uid ตัวเอง, role = member, เครดิตเริ่มต้น 0
      allow create: if isOwner(uid)
                    && request.resource.data.role == 'member'
                    && request.resource.data.credit == 0;

      // แก้โปรไฟล์ตัวเองได้ แต่ห้ามแตะ role และ credit เด็ดขาด
      allow update: if isAdmin()
                    || (isOwner(uid) && unchanged(['role', 'credit']));

      allow delete: if isAdmin();
    }

    // ===== สินค้า =====
    match /products/{id} {
      allow read: if true;                 // ลูกค้าดูได้ทุกคน
      allow write: if isAdmin();           // แก้ไขได้เฉพาะแอดมิน
    }

    // ===== ออเดอร์ =====
    match /orders/{id} {
      // สั่งซื้อได้เฉพาะสมาชิกที่ล็อกอิน และต้องเริ่มที่สถานะ pending เสมอ
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.total is number
                    && request.resource.data.total > 0;

      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);

      // อนุมัติ/ไม่อนุมัติ ทำได้เฉพาะแอดมิน
      allow update, delete: if isAdmin();
    }

    // ===== คำขอเติมเงิน =====
    match /topups/{id} {
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.amount is number
                    && request.resource.data.amount > 0;

      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}

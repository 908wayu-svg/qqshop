rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    // ===== ใครคือแอดมิน =====
    // ต้องผ่านพร้อมกัน 2 ชั้น:
    //   1) custom claim `admin: true` ที่เซ็นมากับโทเคนของ Firebase Auth
    //      ตั้งได้จากเซิร์ฟเวอร์เท่านั้น (Worker /admin/role) เบราว์เซอร์ปลอมไม่ได้
    //   2) users/{uid}.role == 'admin' ในฐานข้อมูล
    //      ฟิลด์นี้เบราว์เซอร์เขียนไม่ได้เลย (ดูกฎ users ด้านล่าง)
    //
    // เดิมเช็คจากรายชื่ออีเมลที่ฝังไว้ในไฟล์นี้ + auth.js — ใครยึดอีเมลนั้นได้
    // ก็เป็นแอดมินทันที และถ้าแก้ลิสต์ไม่ตรงกันสองที่ก็กลายเป็นช่องโหว่
    //
    // ที่ต้องมีชั้นที่ 2 ด้วย: โทเคนใบที่ออกไปก่อนถอนสิทธิ์จะมี claim ค้างได้ถึง 1 ชั่วโมง
    // พอเอกสารถูกลดเป็น member กฎนี้ก็ปฏิเสธทันที ไม่ต้องรอโทเคนหมดอายุ
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.get('admin', false) == true
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.get('role', '') == 'admin';
    }

    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // ===== สมาชิก =====
    match /users/{uid} {
      allow read: if isAdmin() || isOwner(uid);

      // สมัครใหม่: ต้องเป็น uid ตัวเอง, role = member, เครดิตเริ่มต้น 0
      // อีเมลต้องตรงกับอีเมลที่ล็อกอินจริง และห้ามแนบฟิลด์แปลกปลอมเข้ามา
      // (เดิมกรอกอีเมลเป็นของคนอื่นได้ ทำให้รายชื่อในหลังบ้านชี้ตัวคนผิด)
      allow create: if isOwner(uid)
                    && request.resource.data.role == 'member'
                    && request.resource.data.credit == 0
                    && request.resource.data.get('email', '') == request.auth.token.get('email', '')
                    && request.resource.data.keys().hasOnly(
                         ['uid', 'email', 'name', 'phone', 'provider', 'role', 'credit', 'createdAt']);

      // ===== หัวใจของความปลอดภัยทั้งระบบ =====
      // ไม่มีใครแก้ credit หรือ role ผ่านเบราว์เซอร์ได้อีกแล้ว — รวมถึงแอดมินเอง
      // เครดิตเปลี่ยนได้ทางเดียวคือผ่าน Worker (service account ไม่อยู่ใต้กฎนี้)
      // ซึ่งตรวจสิทธิ์ซ้ำเองและบันทึกลง adminLogs ทุกครั้ง
      //
      // เหตุผล: บัญชีแอดมินหลุดมือเมื่อไหร่ คนที่ได้ไปจะเติมเครดิตให้ตัวเอง
      // หรือตั้งตัวเองเป็นแอดมินถาวรไม่ได้ ต้องผ่านเส้นทางที่มีร่องรอยเสมอ
      allow update: if (isOwner(uid) || isAdmin())
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['name', 'phone'])
                    && request.resource.data.get('name', '') is string
                    && request.resource.data.get('name', '').size() < 120
                    && request.resource.data.get('phone', '') is string
                    && request.resource.data.get('phone', '').size() < 40;

      allow delete: if isAdmin();
    }

    // ===== สินค้า =====
    match /products/{id} {
      allow read: if true;                 // ลูกค้าดูได้ทุกคน
      allow write: if isAdmin();           // แก้ไขได้เฉพาะแอดมิน

      // คลังของสินค้าดิจิทัล — เก็บไอดี/รหัสผ่านรายชิ้น
      // ห้ามลูกค้าอ่านเด็ดขาด (ต่อให้เป็นชิ้นที่ตัวเองซื้อ)
      // ลูกค้าเห็นรหัสจากในออเดอร์ของตัวเองที่เซิร์ฟเวอร์คัดลอกไปให้ตอนอนุมัติแทน
      match /stockItems/{itemId} {
        allow read, write: if isAdmin();
      }
    }

    // ===== รูปสินค้า (แยกออกจากเอกสารสินค้า) =====
    // ทุกคนดูได้เหมือนสินค้า แต่หน้าร้านโหลดเฉพาะใบที่เลื่อนมาถึง
    match /productImages/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ===== ตั้งค่าร้าน (เช่น จุดเริ่มนับยอดขาย) =====
    match /settings/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ===== ออเดอร์ =====
    match /orders/{id} {
      // เบราว์เซอร์สร้าง/แก้/ลบออเดอร์เองไม่ได้เลย ต้องผ่าน Worker เท่านั้น
      // ที่คิดราคาจากฐานข้อมูลเอง ลูกค้าจึงแก้ราคา/จำนวนก่อนส่งไม่ได้
      // (เซิร์ฟเวอร์ใช้ service account ซึ่งไม่ถูกกฎนี้บังคับ)
      //
      // ปิดฝั่งแอดมินด้วย เพราะ "อนุมัติออเดอร์" = หักเครดิตลูกค้า + ส่งมอบไอดี
      // ถ้าเบราว์เซอร์ยังเขียนได้ บัญชีแอดมินที่หลุดจะแก้ยอด/ปั๊มของออกไปได้เงียบๆ
      allow create, update, delete: if false;

      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // ===== คำขอเติมเงิน =====
    match /topups/{id} {
      // สลิปต้องเป็นรูปภาพแบบ data: จริงๆ ไม่ใช่สตริงอะไรก็ได้
      // (กันลูกค้ายัดสคริปต์เข้าหน้าแอดมิน)
      function slipOk() {
        return !('slip' in request.resource.data.keys())
               || (request.resource.data.slip is string
                   && request.resource.data.slip.matches('^data:image/(png|jpeg|jpg|gif|webp);base64,[A-Za-z0-9+/=]+$')
                   && request.resource.data.slip.size() < 1000000);
      }
      // ลิงก์ซองต้องเป็นลิงก์ทรูมันนี่เท่านั้น
      function angpaoOk() {
        return !('angpaoLink' in request.resource.data.keys())
               || (request.resource.data.angpaoLink is string
                   && request.resource.data.angpaoLink.matches('^https://[a-z0-9.-]*truemoney[.]com/.*')
                   && request.resource.data.angpaoLink.size() < 500);
      }

      // ต้องมีหลักฐานแนบเสมอ: สลิป (เก็บแยกที่ topupSlips) หรือลิงก์ซองอั่งเปา
      // ไม่งั้นลูกค้าสร้างรายการเปล่าๆ ยอดเท่าไหร่ก็ได้ ให้ดูเหมือนแอดมินเป็นคนเติมให้
      // hasSlip = แบบใหม่ (สลิปอยู่ที่ topupSlips) / slip = แบบเก่าที่ยังฝังในเอกสาร
      // ต้องรับทั้งสองแบบ ไม่งั้นคนที่ยังเปิดหน้าเว็บเวอร์ชันเก่าค้างไว้จะเติมเงินไม่ได้
      function hasProof() {
        return request.resource.data.method == 'angpao'
          ? ('angpaoLink' in request.resource.data.keys())
          : (request.resource.data.get('hasSlip', false) == true
             || 'slip' in request.resource.data.keys());
      }

      // ลูกค้าสร้างคำขอของตัวเองได้ และต้องเริ่มที่สถานะ pending เสมอ
      // แอดมินสร้างเองจากเบราว์เซอร์ไม่ได้แล้ว — รายการที่แอดมินเติมให้สมาชิก
      // ถูกสร้างโดย Worker ตอนปรับเครดิต (กันสร้างรายการ "อนุมัติแล้ว" ปลอมๆ
      // ให้ดูเหมือนมีเงินเข้าร้านทั้งที่ไม่มี)
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.amount is number
                    && request.resource.data.amount > 0
                    && request.resource.data.amount <= 100000
                    && request.resource.data.method in
                         ['truewallet', 'bank', 'promptpay', 'angpao']
                    && hasProof()
                    && slipOk() && angpaoOk();

      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);

      // อนุมัติ/ไม่อนุมัติ ทำที่ Worker เท่านั้น เพราะทั้งสองอย่างขยับเครดิตจริง
      allow update, delete: if false;
    }

    // ===== ภาพสลิป (แยกออกจาก topups) =====
    // สลิปเป็น base64 ก้อนใหญ่ ถ้าเก็บรวมในเอกสาร topups หน้าแอดมินจะต้องโหลด
    // รูปทุกใบพร้อมกันตอนเปิดตาราง — หลายสิบ MB จนเบราว์เซอร์ค้าง
    // แยกไว้ที่นี่ แล้วโหลดเฉพาะใบที่แอดมินกดดู
    match /topupSlips/{id} {
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.slip is string
                    && request.resource.data.slip.matches('^data:image/(png|jpeg|jpg|gif|webp);base64,[A-Za-z0-9+/=]+$')
                    && request.resource.data.slip.size() < 1000000;

      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);

      // สลิปที่แนบไปแล้วห้ามแก้ (กันเปลี่ยนหลักฐานหลังแอดมินดูแล้ว)
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ===== บันทึกการกระทำของแอดมิน =====
    // เซิร์ฟเวอร์เขียนอย่างเดียว (service account ไม่อยู่ใต้กฎนี้)
    // เบราว์เซอร์แก้/ลบไม่ได้เลย เพื่อให้ร่องรอยการปรับเครดิตและการตั้งสิทธิ์ลบไม่ได้
    match /adminLogs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
